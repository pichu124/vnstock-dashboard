# AI Brief Agent API keys
# Copy file này thành .env rồi điền key của bạn vào
# Chỉ cần điền key của provider bạn muốn dùng, bỏ trống = agent đó tắt

# ── Trả phí ────────────────────────────────────────────────────────────────

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Miễn phí / rất rẻ ──────────────────────────────────────────────────────

# Groq (miễn phí 14.400 req/ngày, rất nhanh) — https://console.groq.com
GROQ_API_KEY=

# Mistral (có free tier) — https://console.mistral.ai
MISTRAL_API_KEY=

# DeepSeek (code rất tốt, giá rẻ ~$0.14/1M token) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Cerebras (nhanh nhất ~2000 tok/s, free tier) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter (1 key dùng 100+ models, nhiều model free) — https://openrouter.ai/keys
# Model mặc định: meta-llama/llama-3.3-70b-instruct:free (miễn phí)
# Đổi model trong data_warehouse/_meta/brief_agents.json
OPENROUTER_API_KEY=

# Google AI Studio / Gemini (free 1,500 req/ngày cho 2.5 flash & flash-lite,
# không cần thẻ; LƯU Ý: điều khoản free tier cho phép Google dùng prompt để
# training) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Engine Claude Code (thuê bao, KHÔNG cần key) — 30/09 ─────────────────────
# Một công tắc cho cả 5 bước LLM (news · audit · train · reflection · brief):
#   VNSTOCK_LLM_ENGINE=claude          # claude | ladder (mặc định ladder free)
# Đè riêng từng bước (ladder = tắt lẻ):
#   VNSTOCK_BRIEF_ENGINE=claude
#   VNSTOCK_NEWS_ENGINE=ladder
#   VNSTOCK_AUDIT_ENGINE= / VNSTOCK_TRAIN_ENGINE= / VNSTOCK_REFLECTION_ENGINE= / VNSTOCK_DIGEST_ENGINE=
# Nút vặn CLI (Task Scheduler dùng PATH registry → NÊN ghim exe; tránh shim .cmd):
#   VNSTOCK_CLAUDE_CLI_EXE=C:\Users\admin\.local\bin\claude.exe
#   VNSTOCK_CLAUDE_CLI_MODEL=claude-opus-5-5
#   VNSTOCK_CLAUDE_CLI_FALLBACK_MODEL=claude-sonnet-5-5   # off = tắt
#   VNSTOCK_CLAUDE_CLI_TIMEOUT_S=600
#   VNSTOCK_CLAUDE_CLI_API_KEY=0        # 1 = cho CLI thấy ANTHROPIC_API_KEY (tính tiền API)
# Đè model/trần riêng bước: VNSTOCK_<BRIEF|NEWS|AUDIT|TRAIN|REFLECTION|DIGEST>_CLI_MODEL / _CLI_TIMEOUT_S
# Kiểm: python vnstock_brief_pack.py --check   (dưới tài khoản chạy task)
