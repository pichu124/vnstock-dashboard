# AI Brief Agent API keys
# Copy file này thành .env rồi điền key của bạn vào
# Chỉ cần điền key của provider bạn muốn dùng, bỏ trống = agent đó tắt

# ── Trả phí ────────────────────────────────────────────────────────────────

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Miễn phí / rất rẻ ──────────────────────────────────────────────────────

# Groq (miễn phí 14.400 req/ngày, rất nhanh) — https://console.groq.com
GROQ_API_KEY=

# Mistral (có free tier) — https://console.mistral.ai
MISTRAL_API_KEY=

# DeepSeek (code rất tốt, giá rẻ ~$0.14/1M token) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Cerebras (nhanh nhất ~2000 tok/s, free tier) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter (1 key dùng 100+ models, nhiều model free) — https://openrouter.ai/keys
# Model mặc định: meta-llama/llama-3.3-70b-instruct:free (miễn phí)
# Đổi model trong data_warehouse/_meta/brief_agents.json
OPENROUTER_API_KEY=

# Google AI Studio / Gemini (free 1,500 req/ngày cho 2.5 flash & flash-lite,
# không cần thẻ; LƯU Ý: điều khoản free tier cho phép Google dùng prompt để
# training) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
